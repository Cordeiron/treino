# GEMINI_API_KEY: Not used by REBECA RACING (100% deterministic logic, no AI).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE: Required for Supabase Auth & PostgreSQL persistence in production / Vercel.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
